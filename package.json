{
  "name": "amnesty-dao-application",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "backend:network:start": "pnpm exec icp network start -d",
    "backend:network:start:isolated": "pnpm exec icp network start amnesty-local -d",
    "backend:network:status": "pnpm exec icp network status --json",
    "backend:deploy": "pnpm exec icp deploy -y",
    "backend:deploy:isolated": "pnpm exec icp deploy -e amnesty-local -y",
    "frontend:env:local": "node scripts/write-local-env.mjs",
    "frontend:env:isolated": "ICP_NETWORK_NAME=amnesty-local node scripts/write-local-env.mjs",
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "test:backend": "pnpm exec icp build backend && vitest run --config vitest.config.ts",
    "test:frontend": "vitest run --config vitest.frontend.config.ts"
  },
  "dependencies": {
    "@dfinity/auth-client": "3.4.3",
    "@dfinity/principal": "3.4.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@event-calendar/core": "^5.7.0",
    "@icp-sdk/core": "5.3.0",
    "@tanstack/react-query": "5.99.2",
    "i18next": "^26.0.8",
    "lucide-react": "^1.14.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^17.0.6",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@dfinity/pic": "^0.21.0",
    "@tailwindcss/typography": "0.5.19",
    "@types/node": "24.9.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react-swc": "4.3.0",
    "autoprefixer": "10.4.21",
    "ic-mops": "2.12.2",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3",
    "vite": "8.0.9",
    "vitest": "^4.1.5"
  }
}
