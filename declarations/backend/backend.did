type WorkspaceRole = 
 variant {
   editor;
   owner;
   viewer;
 };
type WorkspaceAccessEntry = 
 record {
   role: WorkspaceRole;
   user: principal;
 };
type UserProfile = record {name: text;};
type TransformationOutput = 
 record {
   body: blob;
   headers: vec Header;
   status: nat;
 };
type TransformationInput = 
 record {
   context: blob;
   response: TransformationOutput;
 };
type StripeSessionStatus = 
 variant {
   completed: record {
                response: text;
                userPrincipal: opt text;
              };
   failed: record {error: text;};
 };
type StripeConfiguration = 
 record {
   allowedCountries: vec text;
   secretKey: text;
 };
type ShoppingItem = 
 record {
   currency: text;
   priceInCents: nat;
   productDescription: text;
   productName: text;
   quantity: nat;
 };
type ProposalState = 
 variant {
   active;
   failed;
   passed;
   pendingFinalization;
 };
type ProposalOverrides = 
 record {
   passPct: opt nat;
   quorum: opt nat;
   windowNs: opt nat;
 };
type Proposal = 
 record {
   communityId: nat;
   creator: principal;
   description: text;
   endNs: int;
   id: nat;
   no: nat;
   passPct: nat;
   quorum: nat;
   startNs: int;
   state: ProposalState;
   title: text;
   yes: nat;
 };
type PlatformRole = variant {platformAdmin;};
type KanbanColumn = 
 record {
   cardIds: vec nat;
   id: nat;
   title: text;
 };
type KanbanCardInput = 
 record {
   assignedTo: vec principal;
   description: opt text;
   docId: opt nat;
   dueDateUtc: opt int;
   eventId: opt nat;
   title: text;
 };
type KanbanCard = 
 record {
   assignedTo: vec principal;
   createdAt: int;
   createdBy: principal;
   description: opt text;
   docId: opt nat;
   dueDateUtc: opt int;
   eventId: opt nat;
   id: nat;
   title: text;
   updatedAt: int;
 };
type Header = 
 record {
   name: text;
   value: text;
 };
type FundraisingCampaignPayload = 
 record {
   archived: bool;
   canContribute: bool;
   canEdit: bool;
   canManagePublicLink: bool;
   communityId: nat;
   contributions: vec CampaignContributionPayload;
   createdNs: int;
   creator: opt principal;
   creatorContact: opt text;
   creatorName: text;
   deadlineNs: int;
   fundsUse: text;
   goalAmount: nat;
   id: nat;
   impact: text;
   mediaUrl: opt text;
   publicToken: opt text;
   shortDescription: text;
   state: CampaignState;
   story: text;
   title: text;
   totalRaised: nat;
   updatedNs: int;
   updates: vec CampaignUpdatePayload;
   visibility: CampaignVisibility;
 };
type FundraisingCampaignInput = 
 record {
   creatorContact: opt text;
   creatorName: text;
   deadlineNs: int;
   fundsUse: text;
   goalAmount: nat;
   impact: text;
   mediaUrl: opt text;
   shortDescription: text;
   story: text;
   title: text;
   visibility: CampaignVisibility;
 };
type Contribution = 
 record {
   amount: nat;
   contributor: principal;
   timestampNs: int;
 };
type CommunityRole = 
 variant {
   communityAdmin;
   member;
 };
type CommunityMember = 
 record {
   "principal": principal;
   profile: opt UserProfile;
   role: CommunityRole;
 };
type CommunityEventPayload = 
 record {
   access: vec WorkspaceAccessEntry;
   allDay: bool;
   archived: bool;
   communityId: nat;
   communityShare: opt WorkspaceRole;
   createdAt: int;
   description: opt text;
   endUtc: int;
   id: nat;
   location: opt text;
   owner: principal;
   publicToken: opt text;
   role: WorkspaceRole;
   startUtc: int;
   title: text;
   updatedAt: int;
 };
type CommunityEventInput = 
 record {
   allDay: bool;
   description: opt text;
   endUtc: int;
   location: opt text;
   startUtc: int;
   title: text;
 };
type CommunityDocumentSummary = 
 record {
   archived: bool;
   communityId: nat;
   communityShare: opt WorkspaceRole;
   createdAt: int;
   id: nat;
   owner: principal;
   parentId: opt nat;
   role: WorkspaceRole;
   title: text;
   updatedAt: int;
   version: nat;
 };
type CommunityDocumentPayload = 
 record {
   access: vec WorkspaceAccessEntry;
   archived: bool;
   communityId: nat;
   communityShare: opt WorkspaceRole;
   createdAt: int;
   id: nat;
   owner: principal;
   parentId: opt nat;
   role: WorkspaceRole;
   snapshot: opt blob;
   title: text;
   updatedAt: int;
   updates: vec blob;
   version: nat;
 };
type CommunityBoardSummary = 
 record {
   archived: bool;
   cardCount: nat;
   columnCount: nat;
   communityId: nat;
   communityShare: opt WorkspaceRole;
   createdAt: int;
   id: nat;
   owner: principal;
   role: WorkspaceRole;
   title: text;
   updatedAt: int;
 };
type CommunityBoardPayload = 
 record {
   access: vec WorkspaceAccessEntry;
   archived: bool;
   cards: vec KanbanCard;
   columns: vec KanbanColumn;
   communityId: nat;
   communityShare: opt WorkspaceRole;
   createdAt: int;
   id: nat;
   owner: principal;
   publicToken: opt text;
   role: WorkspaceRole;
   title: text;
   updatedAt: int;
 };
type CommunityAccess = 
 record {
   canContributeToCampaign: bool;
   canCreateCampaign: bool;
   canCreateProposal: bool;
   canLeaveCommunity: bool;
   canManageMembership: bool;
   canVoteOnProposal: bool;
   communityRole: opt CommunityRole;
   isPlatformAdmin: bool;
 };
type Community = 
 record {
   admin: principal;
   id: nat;
   members: vec principal;
   name: text;
   policy: text;
 };
type CampaignVisibility = 
 variant {
   community;
   publicCampaign;
 };
type CampaignUpdatePayload = 
 record {
   campaignId: nat;
   content: text;
   creatorName: text;
   id: nat;
   timestampNs: int;
 };
type CampaignUpdate = 
 record {
   campaignId: nat;
   content: text;
   creator: principal;
   id: nat;
   timestampNs: int;
 };
type CampaignState = 
 variant {
   active;
   expired;
   failed;
   successful;
 };
type CampaignContributionPayload = 
 record {
   amount: nat;
   contributorName: text;
   timestampNs: int;
 };
type Campaign = 
 record {
   communityId: nat;
   createdNs: int;
   creator: principal;
   deadlineNs: int;
   description: text;
   goalAmount: nat;
   id: nat;
   state: CampaignState;
   title: text;
   totalRaised: nat;
 };
service : {
  addCampaignUpdate: (campaignId: nat, content: text) -> ();
  addCommunityBoardCard: (communityId: nat, boardId: nat, columnId: nat,
   input: KanbanCardInput) -> (KanbanCard);
  addCommunityBoardColumn: (communityId: nat, boardId: nat, title: text) ->
   (KanbanColumn);
  appendCommunityDocumentUpdate: (communityId: nat, documentId: nat, update:
   blob) -> (nat);
  archiveCampaign: (communityId: nat, campaignId: nat) -> ();
  archiveCommunityBoard: (communityId: nat, boardId: nat) -> ();
  archiveCommunityDocument: (communityId: nat, documentId: nat) -> ();
  archiveCommunityEvent: (communityId: nat, eventId: nat) -> ();
  bootstrapPlatformAdmin: () -> ();
  canFinalizeCampaign: (campaignId: nat) -> (bool) query;
  contributeToCampaign: (campaignId: nat, amount: nat) -> ();
  contributeToPublicCampaign: (token: text, amount: nat) -> ();
  createCampaign: (communityId: nat, title: text, description: text,
   goalAmount: nat, deadlineNs: int) -> ();
  createCheckoutSession: (items: vec ShoppingItem, successUrl: text,
   cancelUrl: text) -> (text);
  createCommunity: (name: text, policy: text) -> ();
  createCommunityBoard: (communityId: nat, title: text) -> (nat);
  createCommunityDocument: (communityId: nat, title: text) -> (nat);
  createCommunityEvent: (communityId: nat, input: CommunityEventInput) ->
   (nat);
  createFundraisingCampaign: (communityId: nat, input:
   FundraisingCampaignInput) -> (nat);
  createProposal: (communityId: nat, title: text, description: text,
   overrides: opt ProposalOverrides) -> ();
  deleteCommunityBoardCard: (communityId: nat, boardId: nat, cardId: 
   nat) -> ();
  deleteCommunityBoardColumn: (communityId: nat, boardId: nat, columnId:
   nat) -> ();
  finalizeCampaign: (campaignId: nat) -> ();
  finalizeProposal: (proposalId: nat) -> ();
  getCallerCommunityRole: (communityId: nat) -> (opt CommunityRole) query;
  getCallerPlatformRole: () -> (opt PlatformRole) query;
  getCallerUserProfile: () -> (opt UserProfile) query;
  getCampaignById: (campaignId: nat) -> (opt Campaign) query;
  getCampaignContributions: (campaignId: nat) -> (vec Contribution) query;
  getCampaignUpdates: (campaignId: nat) -> (vec CampaignUpdate) query;
  getCommunityAccess: (communityId: nat) -> (CommunityAccess) query;
  getCommunityBoard: (communityId: nat, boardId: nat) ->
   (opt CommunityBoardPayload) query;
  getCommunityById: (id: nat) -> (opt Community) query;
  getCommunityDocument: (communityId: nat, documentId: nat) ->
   (opt CommunityDocumentPayload) query;
  getCommunityEvent: (communityId: nat, eventId: nat) ->
   (opt CommunityEventPayload) query;
  getFundraisingCampaign: (communityId: nat, campaignId: nat) ->
   (opt FundraisingCampaignPayload) query;
  getProposalById: (proposalId: nat) -> (opt Proposal) query;
  getPublicCampaign: (token: text) -> (opt FundraisingCampaignPayload) query;
  getPublicCommunityBoard: (token: text) -> (opt CommunityBoardPayload) query;
  getPublicCommunityEvent: (token: text) -> (opt CommunityEventPayload) query;
  getStripeSessionStatus: (sessionId: text) -> (StripeSessionStatus);
  getUserProfile: (user: principal) -> (opt UserProfile) query;
  isCallerPlatformAdmin: () -> (bool) query;
  isStripeConfigured: () -> (bool) query;
  leaveCommunity: (communityId: nat) -> ();
  listAllUsers: () -> (vec record {
                             principal;
                             UserProfile;
                           }) query;
  listCampaignsByCommunity: (communityId: nat) -> (vec Campaign) query;
  listCommunities: () -> (vec Community) query;
  listCommunityBoards: (communityId: nat) ->
   (vec CommunityBoardSummary) query;
  listCommunityDocuments: (communityId: nat) ->
   (vec CommunityDocumentSummary) query;
  listCommunityEvents: (communityId: nat) ->
   (vec CommunityEventPayload) query;
  listCommunityMembers: (communityId: nat) -> (vec CommunityMember) query;
  listFundraisingCampaigns: (communityId: nat) ->
   (vec FundraisingCampaignPayload) query;
  listPlatformAdmins: () -> (vec principal) query;
  listProposalsByCommunity: (communityId: nat) -> (vec Proposal) query;
  moveCommunityBoardCard: (communityId: nat, boardId: nat, cardId: nat,
   toColumnId: nat, toIndex: nat) -> ();
  renameCommunityBoard: (communityId: nat, boardId: nat, title: text) -> ();
  renameCommunityBoardColumn: (communityId: nat, boardId: nat, columnId: 
   nat, title: text) -> ();
  renameCommunityDocument: (communityId: nat, documentId: nat, title:
   text) -> ();
  reorderCommunityBoardColumns: (communityId: nat, boardId: nat, columnIds:
   vec nat) -> ();
  saveCallerUserProfile: (profile: UserProfile) -> ();
  saveCommunityDocumentSnapshot: (communityId: nat, documentId: nat,
   snapshot: blob, compactThroughVersion: nat) -> ();
  setCampaignPublicLink: (communityId: nat, campaignId: nat, token:
   opt text) -> (opt text);
  setCommunityBoardGrant: (communityId: nat, boardId: nat, user: principal,
   role: opt WorkspaceRole) -> ();
  setCommunityBoardPublicLink: (communityId: nat, boardId: nat, token:
   opt text) -> (opt text);
  setCommunityBoardShare: (communityId: nat, boardId: nat, role:
   opt WorkspaceRole) -> (opt WorkspaceRole);
  setCommunityDocumentGrant: (communityId: nat, documentId: nat, user:
   principal, role: opt WorkspaceRole) -> ();
  setCommunityDocumentParent: (communityId: nat, documentId: nat, parentId:
   opt nat) -> (opt nat);
  setCommunityDocumentShare: (communityId: nat, documentId: nat, role:
   opt WorkspaceRole) -> (opt WorkspaceRole);
  setCommunityEventGrant: (communityId: nat, eventId: nat, user: principal,
   role: opt WorkspaceRole) -> ();
  setCommunityEventPublicLink: (communityId: nat, eventId: nat, token:
   opt text) -> (opt text);
  setCommunityEventShare: (communityId: nat, eventId: nat, role:
   opt WorkspaceRole) -> (opt WorkspaceRole);
  setCommunityRole: (communityId: nat, user: principal, role:
   opt CommunityRole) -> ();
  setPlatformAdmin: (user: principal, enabled: bool) -> ();
  setStripeConfiguration: (config: StripeConfiguration) -> ();
  transform: (input: TransformationInput) -> (TransformationOutput) query;
  updateCommunityBoardCard: (communityId: nat, boardId: nat, cardId: 
   nat, input: KanbanCardInput) -> ();
  updateCommunityEvent: (communityId: nat, eventId: nat, input:
   CommunityEventInput) -> ();
  updateFundraisingCampaign: (communityId: nat, campaignId: nat, input:
   FundraisingCampaignInput) -> ();
  voteOnProposal: (proposalId: nat, voteYes: bool) -> ();
}
